---
import Base from "../layouts/Base.astro";
import PostList from "../components/PostList.astro";
import { useT, type Locale } from "../i18n";
import { BOTH } from "../i18n/alternates";
import { loadWriting } from "../lib/post-page";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useT(lang);
const { items, ok } = await loadWriting(lang);
if (!ok) Astro.response.status = 503;
---

<Base
  page={{ locale: lang, path: "/writing", available: BOTH }}
  title={t("writing.title")}
  description={t("meta.descriptionWriting")}
  showWriting={items.length > 0}
>
  <section class="writing-page wrap" data-section="writing">
    <header class="intro">
      <h1>{t("writing.title")}</h1>
      <p>{t("writing.intro")}</p>
    </header>
    {items.length ? <PostList lang={lang} items={items} /> : <p class="empty">{ok ? t("writing.empty") : t("errors.serverTitle")}</p>}
  </section>
</Base>

<style>
  .writing-page {
    padding-top: 168px;
    padding-bottom: 200px;
    min-height: 70vh;
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    margin-bottom: var(--s-5);
  }
  h1 {
    font-size: var(--t-h1);
    line-height: 1.1;
  }
  .intro p {
    font-size: var(--t-lead);
    color: var(--ink-2);
    line-height: 1.4;
  }
  .empty {
    color: var(--ink-2);
    border-top: 1px solid var(--hair);
    padding-top: var(--s-3);
  }
</style>
