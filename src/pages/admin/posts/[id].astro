---
import { env } from "cloudflare:workers";
import Admin from "../../../layouts/Admin.astro";
import Editor from "../../../components/admin/Editor.astro";
import { getById } from "../../../lib/posts";

export const prerender = false;
const id = Astro.params.id ?? "";
const post = /^[0-9a-f-]{36}$/.test(id) ? await getById(env.DB, id) : null;
if (!post) return new Response("Not found", { status: 404 });
---

<Admin title={post.i18n.en?.title || post.i18n.zh?.title || "Edit post"} active="posts">
  <div class="page-head"><h1>Edit post</h1><a class="muted" href="/admin/posts">← All posts</a></div>
  <Editor post={post} />
</Admin>
