{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onemorething",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Never expose *.workers.dev; preview URLs stay off until Access protects them (docs/PLAN.md §5).
  "workers_dev": false,
  "preview_urls": false,
  // Custom domains: wrangler creates the DNS records and certificates. www 301s to the apex (middleware).
  "routes": [
    { "pattern": "onemorething.today", "custom_domain": true },
    { "pattern": "www.onemorething.today", "custom_domain": true }
  ],
  "assets": {
    "binding": "ASSETS",
    // Every request reaches the Worker first (src/worker.ts): canonical redirects and security
    // headers then apply to static files too, and admin/API/media can never be served as a file.
    "run_worker_first": true
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "omt",
      // Placeholder until stage 1 provisioning (scripts/provision.sh writes the real id).
      "database_id": "5f7c7457-5249-4abc-8b87-d8afcf9e8d86",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "omt-media" }],
  "ratelimits": [
    { "name": "BEACON_RL", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "ADMIN_RL", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ],
  "vars": {
    // Cloudflare Access team domain, e.g. "gabriel.cloudflareaccess.com", and the app AUD tag.
    // Empty = admin is locked (fail closed) everywhere except `astro dev` on localhost.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  }
}
