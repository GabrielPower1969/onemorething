{
  "name": "onemorething",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "onemorething.today — Gabriel Chen's homepage, portfolio and writing.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/copy-fonts.mjs",
    "prebuild": "node scripts/copy-fonts.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "typecheck": "astro check",
    "i18n:check": "node --no-warnings=ExperimentalWarning scripts/i18n-check.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "npm run i18n:check && npm run typecheck && npm run test",
    "db:migrate:local": "wrangler d1 migrations apply omt --local",
    "db:seed:local": "wrangler d1 execute omt --local --file=scripts/seed.local.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.4",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/noto-serif-sc": "5.3.1",
    "astro": "7.3.8",
    "isbot": "5.2.2",
    "jose": "6.2.12",
    "marked": "18.1.1",
    "xss": "1.0.15"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "5.0.4",
    "wrangler": "4.149.0"
  }
}
